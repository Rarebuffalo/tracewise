# Tracewise website + waitlist: configuration PLACEHOLDERS ONLY. Never put real values in this file or in git.
# Set real values in Vercel → Project → Settings → Environment Variables (Production and, separately, Preview).
# Full checklist and meaning of each: web/docs/deployment.md, section 5.

# ---------------------------------------------------------------- backend (runtime; secret unless noted)
# production on the production environment, preview on preview deployments, local on your machine
WAITLIST_ENV=local
# Runtime role tracewise_waitlist (least privilege). Use the provider's POOLED connection string. SECRET.
WAITLIST_DATABASE_URL=postgresql://tracewise_waitlist:CHANGE_ME@db.example.invalid:5432/tracewise_waitlist?sslmode=require
# Owner role, for migrations only (run from your machine). Do NOT set this in Vercel. SECRET.
WAITLIST_DATABASE_URL_MIGRATIONS=postgresql://OWNER_ROLE:CHANGE_ME@db.example.invalid:5432/tracewise_waitlist?sslmode=require
# ≥ 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`. SECRET.
# Different value per environment. Rotating it invalidates outstanding receipts and remove-me links in sent emails.
WAITLIST_SECRET=
# Origin used in email links. Leave empty to use the preview deployment's own URL on Preview, and
# https://$VERCEL_PROJECT_PRODUCTION_URL (the assigned *.vercel.app URL) on Production;
# set it when the custom domain is live, e.g. https://www.example.com. Not secret.
WAITLIST_PUBLIC_SITE_URL=
# Extra origins allowed to call the API cross-origin (normally empty: the site and API share one origin). Not secret.
WAITLIST_ALLOWED_ORIGINS=
# disabled (default: nothing is sent, nothing is claimed as sent) | resend (real email) | file (local only)
WAITLIST_EMAIL_MODE=disabled
# Resend API key with "sending access" only, restricted to your sending domain. SECRET.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Tracewise <hello@updates.example.com>". Not secret.
WAITLIST_EMAIL_FROM=
# Optional reply-to (e.g. the inbox you read). Not secret.
WAITLIST_EMAIL_REPLY_TO=
# The inbox that receives one notification per CONFIRMED signup. Required for owner notifications; there is no default.
WAITLIST_OWNER_NOTIFY_EMAIL=
# Optional postal address for email footers (needed for commercial email in some places). Not secret.
WAITLIST_POSTAL_ADDRESS=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to the retry endpoint. ≥ 32 random characters. SECRET.
CRON_SECRET=
# Optional Cloudflare Turnstile secret (pair with PUBLIC_TURNSTILE_SITE_KEY). SECRET.
WAITLIST_TURNSTILE_SECRET=
# Confirmation-link lifetime in hours (1–168). Keep PUBLIC_VERIFY_TTL_HOURS equal (the build reads this one too).
WAITLIST_VERIFY_TTL_HOURS=48

# ---------------------------------------------------------------- website build (public: these end up in the HTML)
# Canonical origin once the custom domain is live (default: the Vercel production URL)
PUBLIC_SITE_URL=
# Leave empty: the API is on the same origin
PUBLIC_API_BASE=
# Required for production builds (the privacy notice names who runs the waitlist and how to reach them)
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=
# e.g. "Neon (AWS us-east-1)"
PUBLIC_DATABASE_PROVIDER=
# Optional Cloudflare Turnstile site key (public)
PUBLIC_TURNSTILE_SITE_KEY=
# "true" / "false"; default: indexed only on Vercel production builds
PUBLIC_ALLOW_INDEXING=
