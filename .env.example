# Placeholders only. Never commit real values. See docs/IMPLEMENTATION-PLAN.md section 4.
# Settings are read from the process environment only (no .env loading): `set -a; . ./.env; set +a`.
# The fake provider is accepted only with TW_ENV=test.
TW_ENV=test
DATABASE_URL=postgresql://tracewise_app@localhost:5432/tracewise
# System plane (BYPASSRLS; T-705): webhook ingress, lifecycle, queue, recovery
DATABASE_URL_SYSTEM=postgresql://tracewise_system@localhost:5432/tracewise
DATABASE_URL_MIGRATIONS=postgresql://tracewise_owner@localhost:5432/tracewise
# ops requeue only: YOUR OWN login, a member of tracewise_operator (the audit records it). Never a service role.
# DATABASE_URL_OPERATOR=postgresql://ops_yourname@localhost:5432/tracewise
# LIVE only (Phase 8, project-scoped dev App in the approved test org):
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# openai or gemini with your own key; fake is for tests only (needs TW_ENV=test)
LLM_PROVIDER=fake
OPENAI_API_KEY=
GEMINI_API_KEY=
# The exact model id from your provider (required for openai and gemini; no default)
LLM_MODEL=
# USD per million tokens, from your provider's price list (optional; unset = cost reported as unpriced)
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
INVESTIGATION_MAX_TOOL_CALLS=12
INVESTIGATION_TIMEOUT_S=120
LOG_MAX_BYTES_PER_JOB=2097152
REPORT_MAX_CHARS=60000
# T-703: analyses per installation per UTC month. Leave empty for no quota (the value is an owner decision).
ANALYSIS_QUOTA_MONTHLY=
